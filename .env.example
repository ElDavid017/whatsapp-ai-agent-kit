# ============================================================
# WhatsApp AI Agent Kit — Variables de entorno
# Copia este fichero a .env.local y rellena los valores.
# ============================================================

# ----------------------------------------------------------
# OBLIGATORIO: API Key de OpenRouter
# Obtén la tuya en https://openrouter.ai/keys
# Formato: sk-or-v1-...
# El bot NO arrancará si esta variable está vacía o falta.
# ----------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------
# Modelo de IA a usar (con default openai/gpt-4o-mini)
# Recomendados:
#   openai/gpt-4o-mini          ← balance calidad/precio
#   anthropic/claude-haiku-4-5  ← rápido y económico
#   google/gemini-2.5-flash     ← alternativa Google
#
# ¡IMPORTANTE! NUNCA uses modelos que terminen en :free
# (p.ej. openai/gpt-4o-mini:free) — están saturados y
# devuelven error 429 en producción de forma frecuente.
# ----------------------------------------------------------
OPENROUTER_MODEL=openai/gpt-4o-mini

# ----------------------------------------------------------
# OPCIONAL: Webhook de Google Apps Script para guardar leads
# Si está vacío, la herramienta guardarLead queda inactiva.
# Instrucciones en docs/04-configurar-tools.md
# ----------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=

# ----------------------------------------------------------
# OPCIONAL: URL de Cal.com o Calendly para agendar llamadas
# Ejemplo: https://cal.com/tu-usuario/diagnostico
# Si está vacío, la herramienta agendar queda inactiva.
# /personaliza puede rellenarlo automáticamente.
# ----------------------------------------------------------
CAL_BOOKING_URL=

# ----------------------------------------------------------
# Puerto del panel web Next.js (default: 3000)
# ----------------------------------------------------------
PORT=3000

# ----------------------------------------------------------
# Nivel de log del bot (default: info)
# Opciones: silent | error | warn | info | debug
# ----------------------------------------------------------
LOG_LEVEL=info
